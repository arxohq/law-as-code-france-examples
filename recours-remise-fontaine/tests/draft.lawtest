language "law.core" version "0.2";
package examples.fr.apl.recours_remise_fontaine version "0.1.0";
namespace "urn:law:examples:fr:apl:recours-remise-fontaine";

// Proposed test twins, not executed under the current French blocker.

test "remise-receipt" {
    given {
        context { legal_time @2026-04-15; decision_time @2026-04-15T12:00:00+01:00; knowledge_time @2026-04-15T12:00:00+01:00; timezone "Europe/Paris"; interpretation fr.apl::PpPlancherFinal; interpretation fr.pf.af::ArrondiLignesDss; deadline_policy fr.apl::APL_RECOURS; }
    assert "input-0": fr.apl::demande_remise_gracieuse(entity_ref("urn:law:examples:fr:cnaf:fontaine-remise"), @2026-04-15) { origin case_input; }
    assert "input-1": fr.apl::dette_bien_fonde_non_conteste(entity_ref("urn:law:examples:fr:cnaf:fontaine-remise")) { origin case_input; }
    assert "input-2": fr.apl::organisme_debiteur(entity_ref("urn:law:examples:fr:cnaf:fund"), entity_ref("urn:law:examples:fr:cnaf:fontaine-remise")) { origin case_input; }
    assert "input-3": fr.apl::avis_commission_recours_amiable(entity_ref("urn:law:examples:fr:cnaf:fontaine-remise")) { origin case_input; }
    }
    evaluate truth(fr.apl::accuse_due_avant_remise(entity_ref("urn:law:examples:fr:cnaf:fontaine-remise"), @2026-04-30));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

