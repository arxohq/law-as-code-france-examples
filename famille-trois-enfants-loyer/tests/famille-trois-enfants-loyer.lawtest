test "urn:query:examples-fr-pv-famille-trois-enfants-loyer-Garnier2026Mai" {
    given {
        context { legal_time @2026-05-26; decision_time @2026-05-26T12:00:00+02:00; knowledge_time @2026-05-26T12:00:00+02:00; timezone "Europe/Paris"; deadline_policy fr.pf.cmg::CMG_MOIS_CALENDAIRE; interpretation fr.apl::PpPlancherFinal; interpretation fr.apl::ArrondiCentimeHalfUp; interpretation fr.pf.af::ArrondiLignesDss; }
        assert "chg-caf": fr.apl::organisme_debiteur(entity_ref("urn:law:examples:fr:garnier:caf"), entity_ref("urn:law:examples:fr:garnier:menage")) { origin case_input; }
        assert "chg-aide": fr.apl::aide_demandee(entity_ref("urn:law:examples:fr:garnier:menage"), fr.apl::ALF) { origin case_input; }
        assert "chg-date": fr.apl::changement_modifiant_droits_le(entity_ref("urn:law:examples:fr:garnier:menage"), @2026-05-18) { origin case_input; }
        assert "chg-periode": fr.apl::changement_situation_periode_paiement(entity_ref("urn:law:examples:fr:garnier:menage")) { origin case_input; }
        assert "chg-revision": fr.apl::demande_revision_montant_aide(entity_ref("urn:law:examples:fr:garnier:menage")) { origin case_input; }
    }
    evaluate truth(fr.apl::changement_prend_effet_le(entity_ref("urn:law:examples:fr:garnier:menage"), @2026-06-01));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(fr.apl::EffetChangementDroits);
    evaluate positions();
    expect position(fr.apl::JustifierChangements, ACTIVE);
    expect evaluation_status == COMPUTED;
}
