language "law.core" version "0.2";
package examples.fr.apl.foyer_coefficient_k version "0.1.0";
namespace "urn:law:examples:fr:apl:foyer-coefficient-k";

import fr.apl version "0.1.0";

// ОДНО ДЕЛО ФОЙЕ С K. Вымышленная пара пенсионеров (не реальные люди) живёт в
// конвенционированной résidence autonomie общего типа в зоне II и платит
// redevance 495 € в месяц; ресурсы пары — 12 500 € в год; месяц права — март
// 2026 года. Дело спрашивает у канона доли N, E0, коэффициент K (D. 832-25 1°,
// алгебра которого прочитана по R. 351-61), пособие по формуле Af = K × (E − E0)
// и итог после минорации, шага взносов D. 832-24 и удержания CRDS. Норм нет.
