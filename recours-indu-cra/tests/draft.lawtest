language "law.core" version "0.2";
package examples.fr.prime_activite.recours_indu_cra version "0.1.0";
namespace "urn:law:examples:fr:prime-activite:recours-indu-cra";

// Native test twins for the fictional recorded recovery files.

test "cra-appelpendant" {
    given {
        context { legal_time @2026-04-15; decision_time @2026-04-15T12:00:00+01:00; knowledge_time @2026-04-15T12:00:00+01:00; timezone "Europe/Paris"; }
    assert "input-0": fr.css.prime_activite::indu_constate(entity_ref("urn:law:examples:fr:cnaf:cra:appelpendant"), 600 EUR) { origin case_input; }
    assert "input-1": fr.css.prime_activite::action_non_prescrite(entity_ref("urn:law:examples:fr:cnaf:cra:appelpendant")) { origin case_input; }
    assert "input-2": fr.css.prime_activite::recours_suspensif(entity_ref("urn:law:examples:fr:cnaf:cra:appelpendant")) { origin case_input; }
    }
    evaluate truth(fr.css.prime_activite::recouvrement_suspendu(entity_ref("urn:law:examples:fr:cnaf:cra:appelpendant")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "cra-sansappel" {
    given {
        context { legal_time @2026-04-15; decision_time @2026-04-15T12:00:00+01:00; knowledge_time @2026-04-15T12:00:00+01:00; timezone "Europe/Paris"; }
    assert "input-0": fr.css.prime_activite::indu_constate(entity_ref("urn:law:examples:fr:cnaf:cra:sansappel"), 600 EUR) { origin case_input; }
    assert "input-1": fr.css.prime_activite::action_non_prescrite(entity_ref("urn:law:examples:fr:cnaf:cra:sansappel")) { origin case_input; }
    assert "input-2": fr.css.prime_activite::aucun_recours_suspensif(entity_ref("urn:law:examples:fr:cnaf:cra:sansappel")) { origin case_input; }
    }
    evaluate truth(fr.css.prime_activite::indu_recupere(entity_ref("urn:law:examples:fr:cnaf:cra:sansappel"), 600 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "cra-dossier-divergent-truth" {
    given {
    context { legal_time @2026-04-15; decision_time @2026-04-15T12:00:00+01:00; knowledge_time @2026-04-15T12:00:00+01:00; timezone "Europe/Paris"; }
    assert "input-0": fr.css.prime_activite::indu_constate(entity_ref("urn:law:examples:fr:cnaf:cra:dossierdivergent"), 600 EUR) { origin case_input; }
    assert "input-1": fr.css.prime_activite::action_non_prescrite(entity_ref("urn:law:examples:fr:cnaf:cra:dossierdivergent")) { origin case_input; }
    assert "input-2": fr.css.prime_activite::recours_suspensif(entity_ref("urn:law:examples:fr:cnaf:cra:dossierdivergent")) { origin case_input; }
    // Two fictional records disagree: the fund ledger says no appeal, while the recipient record says one is pending.
    assert "fund-ledger": fr.css.prime_activite::aucun_recours_suspensif(entity_ref("urn:law:examples:fr:cnaf:cra:dossierdivergent")) { origin case_input; }

    }
    evaluate truth(fr.css.prime_activite::indu_recupere(entity_ref("urn:law:examples:fr:cnaf:cra:dossierdivergent"), 600 EUR));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
