test "band-martin" {
    given {
        context { legal_time @2026-04-15; decision_time @2026-04-15T12:00:00+01:00; knowledge_time @2026-04-15T12:00:00+01:00; timezone "Europe/Paris"; interpretation fr.pf.af::ArrondiLignesDss; }
    assert "input-0": fr.pf.af::territoire(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), fr.pf.af::METROPOLE) { origin case_input; }
    assert "input-1": fr.pf.af::nb_enfants_charge(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 2) { origin case_input; }
    assert "input-2": fr.pf.af::ressources_menage(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 30000 EUR) { origin case_input; }
    assert "input-3": fr.pf.af::plafond_base_tranche1_publie(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 66652 EUR) { origin case_input; }
    assert "input-4": fr.pf.af::plafond_base_tranche2_publie(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 93276 EUR) { origin case_input; }
    assert "input-5": fr.pf.af::majoration_plafond_enfant_publiee(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 6664 EUR) { origin case_input; }
    assert "input-6": fr.pf.af::bmaf_retenu(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 478.16 EUR) { origin case_input; }
    assert "input-7": fr.pf.af::nb_majorations_pleines(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 0) { origin case_input; }
    assert "input-8": fr.pf.af::nb_majorations_demi(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 0) { origin case_input; }
    assert "input-9": fr.pf.af::forfait_total_menage(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 0 EUR) { origin case_input; }
    assert "input-10": fr.pf.af::nb_enfants_ase_service(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), 0) { origin case_input; }
    assert "input-11": fr.pf.af::foyer_du_cas(entity_ref("urn:law:examples:fr:cnaf:cohort:martin")) { origin case_input; }
    }
    evaluate truth(fr.pf.af::bande_ressources(entity_ref("urn:law:examples:fr:cnaf:cohort:martin"), fr.pf.af::BANDE_1));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

